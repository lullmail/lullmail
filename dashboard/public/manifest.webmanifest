{
  "name": "email-soft",
  "short_name": "email-soft",
  "description": "A briefing-first, privacy-respecting mail reader.",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fbfbfd",
  "theme_color": "#15161a",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    { "name": "Today", "url": "/today" },
    { "name": "Inbox", "url": "/" },
    { "name": "Reading", "url": "/reading" }
  ]
}
