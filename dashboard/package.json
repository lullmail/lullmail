{
  "name": "lullmail-dashboard",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "neutron-ts dev",
    "build": "neutron-ts build --preset static && touch dist/.gitkeep",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/auth.mjs",
    "test:visual": "node e2e/visual.mjs",
    "e2e:preview": "node e2e/preview.mjs"
  },
  "dependencies": {
    "@neutron-build/cli": "^0.2.3",
    "@neutron-build/core": "^0.2.2",
    "@neutron-build/mail": "^0.1.0",
    "@preact/signals": "^2.11.1",
    "preact": "^10.25.4",
    "preact-render-to-string": "^6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.9.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
