---
import "@fontsource-variable/manrope";
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "../styles/global.css";

const title = "email-soft — Mail in. Life out.";
const description = "A briefing-first mail client that screens new senders once, gives each day an ending, and lets unfinished mail return when it matters.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#20242b" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head" data-header>
      <a class="brand" href="#top" aria-label="email-soft home">
        <span class="brand-mark" aria-hidden="true"><i></i></span>
        <span>email-soft</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#product">Product</a>
        <a href="#trust">Trust</a>
      </nav>
      <a class="preview-link" href="#availability"><i aria-hidden="true"></i>Private preview</a>
    </header>

    <main id="main">
      <section class="hero-film" id="top" data-hero-film aria-labelledby="hero-title">
        <div class="hero-stage">
          <div class="hero-poster" aria-hidden="true">
            <span class="dusk-sun"></span>
            <span class="dusk-horizon"></span>
            <span class="poster-mail mail-a"><i></i></span>
            <span class="poster-mail mail-b"><i></i></span>
            <span class="poster-mail mail-c"><i></i></span>
          </div>
          <canvas class="cinema-canvas" data-cinema aria-hidden="true"></canvas>
          <div class="hero-grain" aria-hidden="true"></div>

          <div class="hero-copy">
            <p class="overline">A briefing-first client for the mailbox you already have.</p>
            <h1 id="hero-title"><span>Mail in.</span><em>Life out.</em></h1>
            <p class="hero-lede">Screen new senders once. Start with the few things that need you. Let everything unfinished return on its day.</p>
            <a class="arrow-link light" href="#product">See the daily loop <span aria-hidden="true">↓</span></a>
          </div>

          <div class="hero-meter" aria-hidden="true">
            <span>Unsorted</span>
            <i><b></b></i>
            <span>Clear</span>
          </div>
        </div>
      </section>

      <section class="product" id="product" aria-labelledby="product-title">
        <header class="section-lead">
          <p class="overline dark">One quiet loop</p>
          <h2 id="product-title">Your inbox can have an ending.</h2>
          <p>Email arrives continuously. Your attention does not have to. email-soft turns the mailbox into a finite briefing, then gets out of the way.</p>
        </header>

        <div class="proof-list">
          <article class="proof">
            <div class="proof-copy">
              <span class="proof-index">01</span>
              <h3>Screen once.</h3>
              <p>Unknown senders wait outside the Inbox. Choose Inbox, Reading, Receipts, or Block once; every future message follows that rule until you change it.</p>
              <small>One decision per sender, not per message.</small>
            </div>

            <div class="app-frame" role="img" aria-label="The Screener showing a new sender waiting for a routing decision">
              <div class="app-topline">
                <b>email-soft</b>
                <span>Today&nbsp;&nbsp; Inbox&nbsp;&nbsp; Screener</span>
                <i>Compose</i>
              </div>
              <div class="app-page screener-page">
                <div class="app-heading">
                  <div><small>The Screener</small><h4>New senders wait here.</h4></div>
                  <span>2 waiting</span>
                </div>
                <div class="sender-row primary-sender">
                  <span class="avatar">S</span>
                  <div class="sender-copy"><b>Sarah Chen</b><span>Contract redlines before Friday</span></div>
                  <small>1 message</small>
                </div>
                <div class="route-row"><span>Inbox</span><span>Reading</span><span>Receipts</span><span>Block</span></div>
                <div class="sender-row quiet-sender">
                  <span class="avatar quiet">N</span>
                  <div class="sender-copy"><b>Nucleon Weekly</b><span>Issue 42: the patient machine</span></div>
                  <small>2 messages</small>
                </div>
              </div>
            </div>
          </article>

          <article class="proof reverse">
            <div class="proof-copy">
              <span class="proof-index">02</span>
              <h3>Start finite.</h3>
              <p>Today shows what needs you, who you are waiting on, and what arrived quietly. When there is nothing left, it says so.</p>
              <small>Board, Calendar, and Notes remain one quiet step away.</small>
            </div>

            <div class="app-frame today-frame" role="img" aria-label="The Today briefing showing two messages that need attention and one person being waited on">
              <div class="app-topline">
                <b>email-soft</b>
                <span>Today&nbsp;&nbsp; Inbox&nbsp;&nbsp; Screener</span>
                <i>Compose</i>
              </div>
              <div class="app-page today-page">
                <div class="today-heading">
                  <small>Today</small>
                  <h4>Tuesday, August 25</h4>
                  <p>2 things need you. This is the whole picture.</p>
                </div>
                <div class="surface-nav"><span>Board</span><span>Calendar</span><span>Notes</span></div>
                <div class="brief-title"><b>Needs you</b><span>2</span></div>
                <div class="brief-row unread"><i></i><div><b>Sarah Chen</b><strong>Contract redlines before Friday</strong><p>I left two comments on the final section...</p></div><time>9:12</time></div>
                <div class="brief-row"><i></i><div><b>Micah Evans</b><strong>Are we still on for the coast?</strong></div><time>Yesterday</time></div>
                <div class="brief-title waiting"><b>You're waiting</b><span>1</span></div>
                <div class="waiting-row"><b>Nadia Flores</b><span>Draft review</span><em>4 days</em></div>
              </div>
            </div>
          </article>

          <article class="proof">
            <div class="proof-copy">
              <span class="proof-index">03</span>
              <h3>Let time hold it.</h3>
              <p>Snooze a thread until tomorrow, next week, or someday. It leaves the Inbox completely and returns exactly when promised.</p>
              <small>Unfinished does not have to mean visible.</small>
            </div>

            <div class="return-frame" role="img" aria-label="A mail return timeline showing a final draft scheduled to return Friday at 9 AM">
              <div class="return-head"><span>Calendar</span><b>August</b></div>
              <div class="return-days"><span>WED<br /><b>26</b></span><span>THU<br /><b>27</b></span><span class="return-day">FRI<br /><b>28</b></span><span>SAT<br /><b>29</b></span><span>SUN<br /><b>30</b></span></div>
              <div class="return-line"><i></i><b></b></div>
              <div class="return-card">
                <small>Back Friday at 9:00</small>
                <strong>Final draft review</strong>
                <span>From Nadia Flores</span>
              </div>
              <p>Until then, there is nothing to maintain.</p>
            </div>
          </article>
        </div>
      </section>

      <section class="trust" id="trust" aria-labelledby="trust-title">
        <header class="trust-intro">
          <p class="overline dark">Your mail remains yours</p>
          <h2 id="trust-title">The exit is part of the product.</h2>
          <p>email-soft processes readable mail to sync and organize it. It does not use your messages for ads, telemetry, or model training.</p>
        </header>

        <div class="trust-list">
          <article><span>01</span><h3>Read without reporting back.</h3><p>Remote images are blocked by default. Common redirect wrappers and campaign parameters are removed.</p></article>
          <article><span>02</span><h3>Credentials stay sealed.</h3><p>Account credentials are encrypted at rest with AES-256-GCM. Passkeys, recovery codes, TOTP, and session revocation are built in.</p></article>
          <article><span>03</span><h3>Leave in standard formats.</h3><p>Download individual messages as EML or a complete account as mailbox-by-mailbox mboxrd. Delete the local account state yourself.</p></article>
          <article><span>04</span><h3>Run the whole thing yourself.</h3><p>One Go binary and Postgres. The complete core is MIT licensed, with no telemetry and no required cloud service.</p></article>
        </div>
      </section>

      <section class="availability" id="availability" aria-labelledby="availability-title">
        <div class="availability-copy">
          <p class="overline">Private preview · Release candidate</p>
          <h2 id="availability-title">Mail should make room for life.</h2>
          <p>The standalone product path is complete. A named-domain deployment, public provider approval, and final real-provider verification remain before launch.</p>
        </div>
        <div class="availability-meta">
          <span>IMAP + JMAP</span><span>One owner</span><span>MIT licensed</span><span>Self-hostable</span>
        </div>
        <footer class="site-foot">
          <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true"><i></i></span><span>email-soft</span></a>
          <p>Working name · 2026</p>
          <div><a href="#product">Product</a><a href="#trust">Trust</a><a href="#top">Back to top ↑</a></div>
        </footer>
      </section>
    </main>

    <script>
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const desktop = window.matchMedia("(min-width: 701px)").matches;

      if (!reduced && desktop) {
        requestAnimationFrame(() => requestAnimationFrame(() => import("../scripts/cinematic")));
      }

      const header = document.querySelector("[data-header]");
      const product = document.querySelector("#product");
      const syncHeader = () => {
        if (!header || !product) return;
        header.classList.toggle("on-paper", product.getBoundingClientRect().top <= 72);
      };
      syncHeader();
      addEventListener("scroll", syncHeader, { passive: true });
      addEventListener("resize", syncHeader, { passive: true });

    </script>
  </body>
</html>
