.DS_Store
.env
dashboard/node_modules/
dashboard/dist/*
site/node_modules/
site/dist/
/lullmail
/output/

# Local-only working doc + archive of its predecessors. Public-repo policy
# (AGENTS.md): never commit these; they stay on disk as untracked scratch.
STATUS.md
/_archive/

# Dev-only workspace into the live Neutron checkout; deploys use the vendored
# mail-engine/ instead. Not committable: clones without the sibling would fail.
go.work

# go:embed needs dashboard/dist to exist on a fresh clone; the app serves a
# "dashboard not built" notice from this placeholder until npm run build.
# dashboard/dist/* (not the dir) so the negation below can actually apply.
!dashboard/dist/.gitkeep

# A server run without LULL_DATA_DIR writes its generated secret.key here.
# Never committable.
data/
